# ======================================================================
# MODULE 1: First-Pass Processing & Quality Control (Contamination Removal)
# ======================================================================
# Standard log-normalization and initial feature selection
CD4 <- NormalizeData(CD4, verbose = TRUE) %>%
  FindVariableFeatures(selection.method = "vst", nfeatures = 2000)

# Construct comprehensive technical and non-T cell feature blacklist
hsp_genes   <- grep(pattern = "^HSP",   rownames(CD4), value = TRUE)
mt_genes    <- grep(pattern = "^MT-",   rownames(CD4), value = TRUE)
rpl_genes   <- grep(pattern = "^RPL",   rownames(CD4), value = TRUE)
rps_genes   <- grep(pattern = "^RPS",   rownames(CD4), value = TRUE)
tb_genes    <- grep(pattern = "^TB",    rownames(CD4), value = TRUE)
ig_v_genes  <- grep(pattern = "^IG[LHV]V", rownames(CD4), value = TRUE)
ig_l_genes  <- grep(pattern = "^IGLL",   rownames(CD4), value = TRUE)
ig_c_genes  <- grep(pattern = "^IGLC",   rownames(CD4), value = TRUE)
malat1      <- grep(pattern = "^MALAT1$", rownames(CD4), value = TRUE)

gene_blacklist <- c(hsp_genes, mt_genes, rpl_genes, rps_genes, tb_genes, 
                    ig_v_genes, ig_l_genes, ig_c_genes, malat1)

# Overwrite VariableFeatures to bypass the technical blacklist downstream
VariableFeatures(CD4) <- setdiff(VariableFeatures(CD4), gene_blacklist)

# Regress out technical and proliferative variation confounding components
CD4 <- ScaleData(CD4, vars.to.regress = c("percent.mt", "S.Score", "G2M.Score"), verbose = TRUE) %>%
  RunPCA(npcs = 30, verbose = TRUE)

# Execute batch effect correction using Harmony
library(harmony)
CD4 <- RunHarmony(CD4, group.by.vars = "orig.ident")

# Construct topological manifolds and clusters based on Harmony embeddings
CD4 <- CD4 %>%
  RunUMAP(reduction = "harmony", dims = 1:30) %>%
  RunTSNE(reduction = "harmony", dims = 1:30) %>%
  FindNeighbors(reduction = "harmony", dims = 1:30) %>%
  FindClusters(resolution = 1.0)

# Filter out contaminating clusters displaying non-CD4 lineages (e.g., FOXP3- CD8A+ Escapes)
CD4 <- subset(CD4, idents = non_cd4_contaminant_clusters, invert = TRUE)
gc()


# ======================================================================
# MODULE 2: Second-Pass Refinement, Dimensional Reduction, & Clustering Tree
# ======================================================================
# Re-normalize and re-select variable features following subsetting to capture true CD4 substructures
CD4 <- NormalizeData(CD4, verbose = TRUE) %>%
  FindVariableFeatures(selection.method = "vst", nfeatures = 2000)

VariableFeatures(CD4) <- setdiff(VariableFeatures(CD4), gene_blacklist)

CD4 <- ScaleData(CD4, vars.to.regress = c("percent.mt", "S.Score", "G2M.Score"), verbose = TRUE) %>%
  RunPCA(npcs = 30, verbose = TRUE) %>%
  RunHarmony(group.by.vars = "orig.ident")

CD4 <- CD4 %>%
  RunUMAP(reduction = "harmony", dims = 1:30) %>%
  RunTSNE(reduction = "harmony", dims = 1:30) %>%
  FindNeighbors(reduction = "harmony", dims = 1:30)

# Evaluate cluster stability across an optimized multi-resolution spectrum
library(clustree)
tree_eval <- FindClusters(CD4, resolution = seq(0, 1.8, by = 0.2))
p_tree    <- clustree(tree_eval@meta.data, prefix = "RNA_snn_res.")
print(p_tree)

# Lock in the optimized low-resolution setting stable for distinct biological lineages
CD4 <- FindClusters(CD4, resolution = 0.2)


# ======================================================================
# MODULE 3: Differential Expression Testing & Publication-Grade Annotation
# ======================================================================
# Identify global cluster-specific transcriptomic markers via non-parametric Wilcoxon rank-sum tests
cluster_markers <- FindAllMarkers(CD4, logfc.threshold = 0.25, only.pos = FALSE, verbose = TRUE)
write.csv(cluster_markers, file = output_marker_csv, row.names = FALSE)

# Define reference-validated annotation mappings based on canonical canonical markers
# Cluster 0: TNFRSF9+ Treg | Cluster 1: CCR7+ Tconv | Cluster 2: Th1-like | Cluster 3: CXCR4+ FOXP3+ Treg | Cluster 4: CCL5+ Tconv | Cluster 5: CXCL13+ Tfh
annotation_mapping <- c(
  "0" = "CD4_TNFRSF9_Treg",
  "1" = "CD4_CCR7_Tconv",
  "2" = "CD4_Th1_like",
  "3" = "CD4_FOXP3_Treg",
  "4" = "CD4_CCL5_Tconv",
  "5" = "CD4_CXCL13_Tfh"
)

CD4$celltype_fine <- factor(
  annotation_mapping[as.character(CD4$seurat_clusters)],
  levels = c("CD4_CCR7_Tconv", "CD4_CCL5_Tconv", "CD4_CXCL13_Tfh", 
             "CD4_FOXP3_Treg", "CD4_TNFRSF9_Treg", "CD4_Th1_like")
)


# ======================================================================
# MODULE 4: Cleanup, Visualization, & Final Persistence
# ======================================================================
# Drop redundant clustering resolution parameters from metadata slot
metadata_keep_cols <- !colnames(CD4@meta.data) %in% grep("^RNA_snn_res\\.", colnames(CD4@meta.data), value = TRUE)
CD4@meta.data      <- CD4@meta.data[, metadata_keep_cols]

# Generate publication-grade manifold visualizations
p_umap <- DimPlot(CD4, reduction = 'umap', group.by = 'celltype_fine', label = TRUE, repel = TRUE) + 
  theme_bw() + theme(panel.grid = element_blank())

p_tsne <- DimPlot(CD4, reduction = 'tsne', group.by = 'celltype_fine', label = TRUE, repel = TRUE) + 
  theme_bw() + theme(panel.grid = element_blank())

print(p_umap + p_tsne)

# Persist fully annotated CD4 T cell object
saveRDS(CD4, file = output_annotated_rds)
gc()
